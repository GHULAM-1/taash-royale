{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "routes/**/*.ts",
    "controllers/**/*.ts",
    "utils/db.ts",
    "models/**/*.ts"
  ]
}